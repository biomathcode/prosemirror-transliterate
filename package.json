{
  "name": "prosemirror-transliterate",
  "type": "module",
  "version": "0.0.0",
  "description": "Provider-agnostic transliteration suggestions for ProseMirror, with keyboard navigation, cancellation, and TypeScript support.",
  "author": "Pratik Sharma <sharma.pratik2016@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/biomathcode/prosemirror-transliterate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biomathcode/prosemirror-transliterate.git"
  },
  "bugs": {
    "url": "https://github.com/biomathcode/prosemirror-transliterate/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node scripts/copy-assets.mjs",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p website/tsconfig.json --noEmit",
    "site:dev": "pnpm run docs:generate && vite --config website/vite.config.ts --host 127.0.0.1",
    "site:build": "pnpm run build && pnpm run docs:generate && vite build --config website/vite.config.ts",
    "site:preview": "vite preview --config website/vite.config.ts --host 127.0.0.1",
    "site:deploy": "pnpm run site:build && wrangler deploy",
    "site:check": "pnpm run site:build && wrangler deploy --dry-run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run site:build",
    "prepublishOnly": "pnpm run check",
    "docs:generate": "node scripts/generate-docs.mjs",
    "test:package": "pnpm run build && node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsdown": "^0.21.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.6",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-commands": "^1.7.1",
    "jsdom": "^26.1.0",
    "@vitest/coverage-v8": "4.0.18",
    "@playwright/test": "^1.58.2",
    "vite": "^7.3.1",
    "wrangler": "^4.0.0",
    "marked": "^17.0.0"
  },
  "keywords": [
    "prosemirror",
    "transliteration",
    "editor",
    "i18n",
    "typescript",
    "indic"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "peerDependencies": {
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
